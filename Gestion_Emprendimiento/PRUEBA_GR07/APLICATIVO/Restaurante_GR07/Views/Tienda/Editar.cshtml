@model Restaurante_GR07.Models.Tienda
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editar Tienda / Empresa</title>
    <style>
        :root {
            --verde: #22C55E;
            --verde-claro: #86EFAC;
            --gris: #1F2937;
            --gris-claro: #F3F4F6;
        }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background-color: var(--gris-claro);
            padding: 20px;
            margin: 0;
        }

        .app-container {
            max-width: 450px;
            margin: 0 auto;
            background: white;
            border-radius: 24px;
            padding: 25px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.05);
            box-sizing: border-box;
        }

        h2 {
            margin-top: 0;
            color: var(--gris);
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        p.subtitle {
            color: #6B7280;
            font-size: 13px;
            margin-bottom: 20px;
            margin-top: 0;
        }

        .form-group {
            margin-bottom: 16px;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-size: 13px;
            font-weight: 600;
            color: #4B5563;
        }

        input[type="text"], input[type="number"], textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #D1D5DB;
            border-radius: 10px;
            box-sizing: border-box;
            font-size: 14px;
        }

            input:focus, textarea:focus {
                border-color: var(--verde);
                outline: none;
            }

        .tinder-upload-container {
            display: flex;
            justify-content: center;
            margin-bottom: 20px;
        }

        .tinder-photo-box {
            width: 100%;
            height: 200px;
            background-color: #F9FAFB;
            border: 2px dashed #D1D5DB;
            border-radius: 16px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            cursor: pointer;
            transition: border-color 0.2s, background-color 0.2s;
        }

            .tinder-photo-box:hover {
                border-color: var(--verde);
                background-color: #F0FDF4;
            }

            .tinder-photo-box input[type="file"] {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                opacity: 0;
                cursor: pointer;
                z-index: 10;
            }

        .tinder-placeholder {
            text-align: center;
            color: #9CA3AF;
            pointer-events: none;
            z-index: 5;
        }

        .tinder-plus-icon {
            font-size: 36px;
            color: var(--verde);
            background: var(--verde-claro);
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 10px;
            font-weight: bold;
            box-shadow: 0 4px 10px rgba(34, 197, 94, 0.2);
        }

        .tinder-placeholder span {
            font-size: 12px;
            font-weight: 600;
            display: block;
        }

        .preview-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: absolute;
            top: 0;
            left: 0;
            z-index: 2;
        }

        .btn-submit {
            width: 100%;
            background: var(--verde);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-weight: bold;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-cancel {
            display: block;
            text-align: center;
            margin-top: 12px;
            color: #6B7280;
            text-decoration: none;
            font-size: 13px;
        }

        .text-danger {
            color: #EF4444;
            font-size: 12px;
        }
    </style>
</head>
<body>
    <div style="max-width: 450px; margin: 10px auto; display: flex; justify-content: flex-start;">
        <a href="/Tienda/Index" style="text-decoration: none; color: #4B5563; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 5px;">
            ← Volver al Inicio
        </a>
    </div>
    <div class="app-container">
        <h2>🏪 Editar Datos de la Tienda</h2>
        <p class="subtitle">Actualiza la información comercial y el logotipo de tu establecimiento.</p>

        <form action="/Tienda/Editar/@Model.usuario_tienda" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="usuario_tienda" value="@Model.usuario_tienda" />

            <div class="form-group">
                <label>Logotipo del Establecimiento</label>
                <div class="tinder-upload-container">
                    <div class="tinder-photo-box" id="photoBox" style="@(Model.logo_local != null ? "border-style: solid; border-color: var(--verde);" : "")">

                        @if (Model.logo_local != null)
                        {
                            <img id="imagePreview" class="preview-img" src="data:image/jpeg;base64,@Convert.ToBase64String(Model.logo_local)" alt="Logo actual" />
                            <div class="tinder-placeholder" id="placeholderContent" style="display: none;">
                                <div class="tinder-plus-icon">+</div>
                                <span>Cambiar logotipo</span>
                            </div>
                        }
                        else
                        {
                            <img id="imagePreview" class="preview-img" alt="Previsualización" style="display: none;" />
                            <div class="tinder-placeholder" id="placeholderContent">
                                <div class="tinder-plus-icon">+</div>
                                <span>Subir logotipo</span>
                            </div>
                        }

                        <input type="file" name="logoArchivo" id="fileInput" accept="image/*" />
                    </div>
                </div>
                @Html.ValidationMessage("logo_local", "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Nombre del Local Comercial</label>
                <input type="text" name="nombre_local" value="@Model.nombre_local" required />
                @Html.ValidationMessageFor(m => m.nombre_local, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Descripción / Slogan de la Tienda</label>
                <textarea name="descripcion_tienda" rows="3" required>@Model.descripcion_tienda</textarea>
                @Html.ValidationMessageFor(m => m.descripcion_tienda, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>RUC del Establecimiento (Opcional)</label>
                <input type="text" name="ruc_local" value="@Model.ruc_local" maxlength="13" />
                @Html.ValidationMessageFor(m => m.ruc_local, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Ubicación / Coordenada de Desplazamiento</label>
                <input type="number" step="any" name="ubicacion_tienda" value="@Model.ubicacion_tienda" required />
                @Html.ValidationMessageFor(m => m.ubicacion_tienda, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn-submit">Guardar Cambios</button>
            <a href="/Tienda/Feed/@Model.usuario_tienda" class="btn-cancel">Cancelar y Volver</a>
        </form>
    </div>

    <script>
        const fileInput = document.getElementById('fileInput');
        const imagePreview = document.getElementById('imagePreview');
        const placeholderContent = document.getElementById('placeholderContent');
        const photoBox = document.getElementById('photoBox');

        fileInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.addEventListener('load', function() {
                    imagePreview.setAttribute('src', this.result);
                    imagePreview.style.display = 'block';
                    placeholderContent.style.display = 'none';
                    photoBox.style.borderStyle = 'solid';
                    photoBox.style.borderColor = 'var(--verde)';
                });
                reader.readAsDataURL(file);
            }
        });
    </script>
</body>
</html>