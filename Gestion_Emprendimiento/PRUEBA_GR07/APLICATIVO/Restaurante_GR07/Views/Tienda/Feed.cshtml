@model Restaurante_GR07.Models.Tienda

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Mi Tienda</title>
    <style>
        :root {
            --verde: #22C55E;
            --verde2: #16A34A;
            --gris: #1F2937;
            --grisClaro: #F3F4F6;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI';
        }

        body {
            background: #F5F5F5;
            padding: 20px;
        }

        .badge-status {
            position: absolute;
            top: 12px;
            right: 12px;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            z-index: 5;
        }

        .badge-disponible {
            background-color: #22C55E;
            color: white;
        }

        .badge-separado {
            background-color: #FBBF24;
            color: #1F2937;
        }

        .badge-vendido {
            background-color: #EF4444;
            color: white;
        }

        .app-layout {
            max-width: 470px;
            margin: auto;
            background: white;
            border-radius: 25px;
            padding: 20px;
            box-shadow: 0 10px 25px rgba(0,0,0,.08);
        }

        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

            .header a {
                text-decoration: none;
                font-size: 22px;
                color: black;
            }

        .perfil {
            text-align: center;
            padding: 20px;
            background: #F9FAFB;
            border-radius: 20px;
            margin-bottom: 25px;
            border: 1px solid #E5E7EB;
        }

        .logo {
            width: 95px;
            height: 95px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid var(--verde);
        }

        .logoFake {
            width: 95px;
            height: 95px;
            border-radius: 50%;
            background: #E5E7EB;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: auto;
            color: gray;
        }

        h2 {
            margin-top: 15px;
        }

        .descripcion {
            margin-top: 8px;
            color: #6B7280;
        }

        .info {
            margin-top: 15px;
            font-size: 13px;
            text-align: left;
        }

        .btnEditar {
            margin-top: 20px;
            display: block;
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            background: var(--verde);
            color: white;
            text-decoration: none;
            font-weight: bold;
        }

        .titulo {
            margin: 25px 0 15px;
            font-size: 18px;
        }

        .cardProducto {
            background: white;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,.08);
            margin-bottom: 20px;
            border: 1px solid #E5E7EB;
        }

            .cardProducto img {
                width: 100%;
                height: 240px;
                object-fit: cover;
            }

        .body {
            padding: 15px;
        }

        .nombre {
            font-size: 18px;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .desc {
            font-size: 13px;
            color: #555;
            margin-bottom: 12px;
        }

        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }

        .tag {
            padding: 6px 10px;
            border-radius: 8px;
            background: #DCFCE7;
            font-size: 12px;
        }

        .sinProductos {
            background: #FEF3C7;
            border-radius: 20px;
            padding: 30px;
            text-align: center;
        }

            .sinProductos h3 {
                margin-bottom: 10px;
            }

            .sinProductos p {
                margin-bottom: 20px;
                color: #555;
            }

        .btnAgregar {
            display: inline-block;
            background: var(--verde);
            color: white;
            padding: 12px 20px;
            text-decoration: none;
            border-radius: 10px;
            font-weight: bold;
            text-align: center;
        }
    </style>
</head>
<body>

    <div class="app-layout">

        <div class="header">
            <a asp-controller="Home" asp-action="Index">←</a>
            <h3>Mi Tienda</h3>
        </div>

        <div style="max-width: 450px; margin: 10px auto; display: flex; justify-content: flex-start;">
            <a href="/Tienda/Index" style="text-decoration: none; color: #4B5563; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 5px;">
                ← Volver al Inicio
            </a>
        </div>

        <div class="perfil">
            @if (Model.logo_local != null)
            {
                <img class="logo" src="data:image/png;base64,@Convert.ToBase64String(Model.logo_local)">
            }
            else
            {
                <div class="logoFake">
                    Sin Logo
                </div>
            }

            <h2>@Model.nombre_local</h2>
            <p class="descripcion">@Model.descripcion_tienda</p>

            <div class="info">
                <b>RUC:</b> @Model.ruc_local
                <br><br>
                <b>Ubicación:</b> @Model.ubicacion_tienda
            </div>

            <a asp-action="Editar" asp-route-id="@Model.usuario_tienda" class="btnEditar">
                Editar Tienda
            </a>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin: 25px 0 15px;">
            <h3 style="font-size: 18px; margin: 0;">Catálogo</h3>
            @if (Model.Productos != null && Model.Productos.Any())
            {
                <a asp-controller="Productos" asp-action="Crear" style="padding: 6px 12px; font-size: 13px;" class="btnAgregar">＋ Añadir</a>
            }
        </div>

        @if (Model.Productos == null || !Model.Productos.Any())
        {
            <div class="sinProductos">
                <h3>😕 Ups...</h3>
                <p>Todavía no has agregado productos. Empieza publicando tu primera prenda.</p>
                <a asp-controller="Productos" asp-action="Crear" class="btnAgregar">＋ Agregar Producto</a>
            </div>
        }
        else
        {
            @foreach (var producto in Model.Productos)
            {
                <div class="cardProducto">
                    <div style="position:relative;">
                        @{
                            string claseEstado = "badge-disponible";
                            if (producto.estado_producto == "Separado")
                            {
                                claseEstado = "badge-separado";
                            }
                            else if (producto.estado_producto == "Vendido")
                            {
                                claseEstado = "badge-vendido";
                            }
                        }
                        <span class="badge-status @claseEstado">@producto.estado_producto</span>

                        @if (producto.foto_producto != null)
                        {
                            <img src="data:image/png;base64,@Convert.ToBase64String(producto.foto_producto)">
                        }
                    </div>

                    <div class="body">
                        <div class="nombre">@producto.nombre_producto</div>
                        <div class="desc">@producto.descripcion_producto</div>

                        <div class="tags">
                            <div class="tag">🎨 @producto.color_producto</div>
                            @if (!string.IsNullOrEmpty(producto.talla_producto))
                            {
                                <div class="tag">📏 @producto.talla_producto</div>
                            }
                            <div class="tag">📦 @producto.dimensiones_producto</div>
                        </div>

                        <br>
                        <a asp-controller="Productos" asp-action="Previsualizar" asp-route-id="@producto.id_producto" class="btnAgregar" style="display: block; width: 100%;">
                            Ver Producto
                        </a>
                    </div>
                </div>
            }
        }
    </div>

</body>
</html>