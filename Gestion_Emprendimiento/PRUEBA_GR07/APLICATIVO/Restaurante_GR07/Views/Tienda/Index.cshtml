@model IEnumerable<Restaurante_GR07.Models.Tienda>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Explorar Tiendas</title>
    <style>
        :root {
            --verde: #22C55E;
            --verde-claro: #86EFAC;
            --gris: #1F2937;
            --gris-claro: #F3F4F6;
        }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background-color: var(--gris-claro);
            margin: 0;
            padding: 20px 10px;
            color: var(--gris);
        }

        .app-layout {
            max-width: 450px;
            margin: 0 auto;
            background: white;
            border-radius: 24px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            overflow: hidden;
            min-height: 850px;
            box-sizing: border-box;
            padding: 20px;
        }

        .header-nav {
            display: flex;
            align-items: center;
            margin-bottom: 20px;
        }

        .btn-back {
            text-decoration: none;
            color: var(--gris);
            font-size: 20px;
            font-weight: bold;
            margin-right: 15px;
        }

        .app-header h2 {
            margin: 0;
            font-size: 20px;
            font-weight: 700;
        }

        .app-header p {
            margin: 4px 0 0;
            font-size: 12px;
            color: #6B7280;
        }

        .stores-list {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-top: 20px;
        }

        .store-card {
            background: white;
            border: 1px solid #E5E7EB;
            border-radius: 18px;
            padding: 16px;
            display: flex;
            align-items: center;
            gap: 14px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.02);
        }

        .store-logo {
            width: 65px;
            height: 65px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--verde-claro);
            flex-shrink: 0;
        }

        .store-logo-placeholder {
            width: 65px;
            height: 65px;
            border-radius: 50%;
            background-color: #E5E7EB;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            color: #6B7280;
            flex-shrink: 0;
            text-align: center;
        }

        .store-info {
            flex-grow: 1;
            overflow: hidden;
        }

        .store-name {
            margin: 0;
            font-size: 15px;
            font-weight: 700;
            color: var(--gris);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .store-desc {
            margin: 4px 0 8px 0;
            font-size: 12px;
            color: #6B7280;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            line-height: 1.4;
        }

        .btn-feed {
            display: inline-block;
            text-decoration: none;
            background-color: var(--verde);
            color: white;
            font-size: 12px;
            font-weight: 600;
            padding: 6px 12px;
            border-radius: 8px;
            transition: opacity 0.2s;
        }

            .btn-feed:hover {
                opacity: 0.9;
            }

        .no-stores {
            text-align: center;
            color: #9CA3AF;
            font-size: 14px;
            padding: 40px 0;
        }
    </style>
</head>
<body>
    <div style="max-width: 450px; margin: 10px auto; display: flex; justify-content: flex-start;">
        <a href="/Tienda/Index" style="text-decoration: none; color: #4B5563; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 5px;">
            ← Volver al Inicio
        </a>
    </div>
    <div class="app-layout">
        <div class="header-nav">
            <a href="/Home/Index" class="btn-back">←</a>
            <div class="app-header">
                <h2>🏪 Tiendas Disponibles</h2>
                <p>Explora los comercios y sus catálogos</p>
            </div>
        </div>

        <div class="stores-list">
            @if (!Model.Any())
            {
                <div class="no-stores">No hay comercios registrados en este momento.</div>
            }
            else
            {
                foreach (var tienda in Model)
                {
                    <div class="store-card">
                        @if (tienda.logo_local != null && tienda.logo_local.Length > 0)
                        {
                            <img src="data:image/png;base64,@Convert.ToBase64String(tienda.logo_local)" class="store-logo" alt="Logo" />
                        }
                        else
                        {
                            <div class="store-logo-placeholder">Sin Logo</div>
                        }

                        <div class="store-info">
                            <h4 class="store-name">@tienda.nombre_local</h4>
                            <p class="store-desc">@tienda.descripcion_tienda</p>
                            <a href="/Tienda/Feed/@tienda.usuario_tienda" class="btn-feed">Ver Catálogo 👀</a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

</body>
</html>