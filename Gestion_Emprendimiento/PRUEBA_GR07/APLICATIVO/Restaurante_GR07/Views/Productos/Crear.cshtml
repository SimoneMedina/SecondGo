@model Restaurante_GR07.Models.Producto
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Agregar Producto</title>
    <style>
        :root {
            --verde: #22C55E;
            --verde-claro: #86EFAC;
            --turquesa: #06B6D4;
            --azul: #2563EB;
            --morado: #7C3AED;
            --gris: #1F2937;
            --gris-claro: #F3F4F6;
        }

        body {
            font-family: 'Segoe UI', system-ui, sans-serif;
            background-color: var(--gris-claro);
            padding: 20px;
            margin: 0;
        }

        .app-container {
            max-width: 450px;
            margin: 0 auto;
            background: white;
            border-radius: 24px;
            padding: 25px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.05);
            box-sizing: border-box;
        }

        h2 {
            margin-top: 0;
            color: var(--gris);
            font-size: 22px;
            font-weight: 700;
        }

        .form-group {
            margin-bottom: 16px;
        }

        label {
            display: block;
            margin-bottom: 6px;
            font-size: 13px;
            font-weight: 600;
            color: #4B5563;
        }

        input[type="text"], textarea, select {
            width: 100%;
            padding: 12px;
            border: 1px solid #D1D5DB;
            border-radius: 10px;
            box-sizing: border-box;
            font-size: 14px;
        }

            input:focus, textarea:focus, select:focus {
                border-color: var(--verde);
                outline: none;
            }

        .tinder-upload-container {
            display: flex;
            justify-content: center;
            margin-bottom: 20px;
        }

        .tinder-photo-box {
            width: 100%;
            height: 280px;
            background-color: #F9FAFB;
            border: 2px dashed #D1D5DB;
            border-radius: 16px;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            cursor: pointer;
            transition: border-color 0.2s, background-color 0.2s;
        }

            .tinder-photo-box:hover {
                border-color: var(--verde);
                background-color: #F0FDF4;
            }

            .tinder-photo-box input[type="file"] {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                opacity: 0;
                cursor: pointer;
            }

        .tinder-placeholder {
            text-align: center;
            color: #9CA3AF;
            pointer-events: none;
        }

        .tinder-plus-icon {
            font-size: 42px;
            color: var(--verde);
            background: var(--verde-claro);
            width: 60px;
            height: 60px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 10px;
            font-weight: bold;
            box-shadow: 0 4px 10px rgba(34, 197, 94, 0.2);
        }

        .tinder-placeholder span {
            font-size: 12px;
            font-weight: 600;
            display: block;
        }

        .preview-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            position: absolute;
            top: 0;
            left: 0;
            display: none;
        }

        .btn-submit {
            width: 100%;
            background: var(--verde);
            color: white;
            border: none;
            padding: 14px;
            border-radius: 12px;
            font-weight: bold;
            cursor: pointer;
            font-size: 14px;
        }

        .btn-cancel {
            display: block;
            text-align: center;
            margin-top: 12px;
            color: #6B7280;
            text-decoration: none;
            font-size: 13px;
        }

        .text-danger {
            color: #EF4444;
            font-size: 12px;
        }

        
    <style>
        .color-picker-container {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #F9FAFB;
            padding: 8px 12px;
            border: 1px solid #D1D5DB;
            border-radius: 10px;
            box-sizing: border-box;
        }

        input[type="color"] {
            -webkit-appearance: none;
            -moz-appearance: none;
            appearance: none;
            width: 40px;
            height: 40px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
        }

            input[type="color"]::-webkit-color-swatch {
                border: 2px solid #E5E7EB;
                border-radius: 50%;
            }

            input[type="color"]::-moz-color-swatch {
                border: 2px solid #E5E7EB;
                border-radius: 50%;
            }

        #colorHexLabel {
            font-size: 14px;
            font-weight: 600;
            color: #4B5563;
            text-transform: uppercase;
            font-family: monospace;
        }
    </style>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const colorPicker = document.getElementById('colorPicker');
            const colorHexLabel = document.getElementById('colorHexLabel');

            colorPicker.addEventListener('input', function () {
                colorHexLabel.textContent = this.value;
            });
        });
    </script>
    </style>
</head>
<body>
    <div style="max-width: 450px; margin: 10px auto; display: flex; justify-content: flex-start;">
        <a href="/Tienda/Index" style="text-decoration: none; color: #4B5563; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 5px;">
            ← Volver al Inicio
        </a>
    </div>
    <div class="app-container">
        <h2>📦 Nuevo Producto</h2>
        <form action="/Productos/Crear" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label>Fotografía del Producto</label>
                <div class="tinder-upload-container">
                    <div class="tinder-photo-box" id="photoBox">
                        <img id="imagePreview" class="preview-img" alt="Previsualización" />
                        <div class="tinder-placeholder" id="placeholderContent">
                            <div class="tinder-plus-icon">+</div>
                            <span>Añadir foto</span>
                        </div>
                        <input type="file" name="fotoArchivo" id="fileInput" accept="image/*" required />
                    </div>
                </div>
                @Html.ValidationMessage("foto_producto", "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                <label>Nombre del Artículo</label>
                <input type="text" name="nombre_producto" required />
            </div>
            <div class="form-group">
                <label>Descripción / Detalles de Uso</label>
                <textarea name="descripcion_producto" rows="3" required></textarea>
            </div>
            <div class="form-group">
                <label>Color del Artículo</label>
                <div class="color-picker-container">
                    <input type="color" name="color_producto" id="colorPicker" value="#22C55E" required />
                    <span id="colorHexLabel">#22C55E</span>
                </div>
            </div>
            <div class="form-group">
                <label>Talla (Opcional)</label>
                <input type="text" name="talla_producto" />
            </div>
            <div class="form-group">
                <label>Dimensiones Estándar</label>
                <input type="text" name="dimensiones_producto" required />
            </div>
            <div class="form-group">
                <label>Estado actual del Artículo</label>
                <select name="estado_producto" id="estadoProductoSelect" class="status-select select-disponible" required>
                    <option value="Disponible" class="opt-disponible">Disponible</option>
                    <option value="Separado" class="opt-separado">Separado</option>
                    <option value="Vendido" class="opt-vendido">Vendido</option>
                </select>
            </div>

            <button type="submit" class="btn-submit">Subir al Catálogo</button>
            <a href="/Productos/Index" class="btn-cancel">Volver</a>
        </form>
    </div>

    <script>
        const fileInput = document.getElementById('fileInput');
        const imagePreview = document.getElementById('imagePreview');
        const placeholderContent = document.getElementById('placeholderContent');
        const photoBox = document.getElementById('photoBox');

        fileInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.addEventListener('load', function() {
                    imagePreview.setAttribute('src', this.result);
                    imagePreview.style.display = 'block';
                    placeholderContent.style.display = 'none';
                    photoBox.style.borderStyle = 'solid';
                    photoBox.style.borderColor = 'var(--verde)';
                });
                reader.readAsDataURL(file);
            } else {
                imagePreview.style.display = 'none';
                placeholderContent.style.display = 'block';
                photoBox.style.borderStyle = 'dashed';
                photoBox.style.borderColor = '#D1D5DB';
            }
        });
    </script>
</body>
</html>