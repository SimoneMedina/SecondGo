@{
    ViewData["Title"] = "Compradores";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Compradores</title>

    <style>
        :root {
            --verde: #22C55E;
            --gris: #374151;
            --fondo: #F3F4F6;
            --amarillo: #FACC15;
        }

        body {
            margin: 0;
            background: var(--fondo);
            font-family: 'Segoe UI',sans-serif;
        }

        .app-layout {
            max-width: 450px;
            margin: 20px auto;
            background: white;
            border-radius: 20px;
            padding: 20px;
            box-shadow: 0 8px 20px rgba(0,0,0,.08);
        }

        h2 {
            margin-bottom: 20px;
            color: var(--gris);
        }

        .buyer-card {
            display: flex;
            gap: 15px;
            background: white;
            border-radius: 15px;
            padding: 12px;
            margin-bottom: 18px;
            border: 1px solid #E5E7EB;
            box-shadow: 0 4px 10px rgba(0,0,0,.05);
        }

            .buyer-card img {
                width: 95px;
                height: 95px;
                object-fit: cover;
                border-radius: 12px;
            }

        .buyer-info {
            flex: 1;
        }

            .buyer-info h4 {
                margin: 0;
                color: #111827;
            }

            .buyer-info p {
                margin: 5px 0;
                color: #6B7280;
                font-size: 13px;
            }

        .estado {
            display: inline-block;
            background: #FEF3C7;
            color: #92400E;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
        }

        .btn {
            margin-top: 10px;
            display: inline-block;
            background: var(--verde);
            color: white;
            padding: 8px 16px;
            text-decoration: none;
            border-radius: 8px;
            font-size: 13px;
        }
    </style>

</head>
<body>
    <div style="max-width: 450px; margin: 10px auto; display: flex; justify-content: flex-start;">
        <a href="/Tienda/Index" style="text-decoration: none; color: #4B5563; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 5px;">
            ← Volver al Inicio
        </a>
    </div>
    <div class="app-layout">

        <h2>Solicitudes / Compradores</h2>

        <div class="buyer-card">

            <img src="https://picsum.photos/120/120?random=1">

            <div class="buyer-info">

                <h4>María López</h4>

                <p><strong>Prenda:</strong> Chaqueta Oversize Beige</p>

                <p><strong>Talla:</strong> M</p>

                <span class="estado">Pendiente</span>

                <br>

                <a href="#" class="btn">Ver detalle</a>

            </div>

        </div>

        <div class="buyer-card">

            <img src="https://picsum.photos/120/120?random=2">

            <div class="buyer-info">

                <h4>Carlos Pérez</h4>

                <p><strong>Prenda:</strong> Jeans Azul Clásico</p>

                <p><strong>Talla:</strong> L</p>

                <span class="estado">Pendiente</span>

                <br>

                <a href="#" class="btn">Ver detalle</a>

            </div>

        </div>

        <div class="buyer-card">

            <img src="https://picsum.photos/120/120?random=3">

            <div class="buyer-info">

                <h4>Ana Gómez</h4>

                <p><strong>Prenda:</strong> Vestido Floral</p>

                <p><strong>Talla:</strong> S</p>

                <span class="estado">Pendiente</span>

                <br>

                <a href="#" class="btn">Ver detalle</a>

            </div>

        </div>

    </div>

</body>
</html>